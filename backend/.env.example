# AI Study Planner — Backend Environment Configuration Example
# IMPORTANT: All production environment variables are verified on startup using Zod.
# WARNING: Any previously exposed secrets must be immediately rotated.

PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb://localhost:27017/ai-study-planner

# Cryptographically Secure JWT Secret Keys (Must be at least 32 characters in length)
JWT_SECRET=replace_with_at_least_32_character_long_secure_random_key_1
JWT_REFRESH_SECRET=replace_with_at_least_32_character_long_secure_random_key_2

# Groq Cloud API Secret Key
GROQ_API_KEY=gsk_replace_with_your_groq_api_secret_key

# CORS Whitelist Origins (Comma separated list for multi-domain configurations)
ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth 2.0 Identity Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Transactional Email Credentials (SMTP Transporter)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Client Web Application Production URL
CLIENT_URL=http://localhost:5173

# AI Config Optionals
AI_MODEL=llama-3.1-8b-instant
AI_INPUT_COST_1M=0.05
AI_OUTPUT_COST_1M=0.08
