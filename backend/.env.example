# AI Study Planner — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# Never commit a real .env file to version control.
# All variables are validated on startup by Zod — the server will refuse to
# start if required values are missing, weak, or known placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
APP_VERSION=1.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas example: mongodb+srv://user:pass@cluster0.example.mongodb.net/studyplanner
MONGO_URI=mongodb://localhost:27017/ai-study-planner

# ── JWT Secrets (must be at least 32 characters each — use a password manager) ──
JWT_SECRET=replace_with_your_own_32plus_char_random_string_here
JWT_REFRESH_SECRET=replace_with_a_different_32plus_char_random_string

# ── Groq AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_replace_with_your_real_groq_api_key_from_console
AI_MODEL=llama-3.1-8b-instant
AI_INPUT_COST_1M=0.05
AI_OUTPUT_COST_1M=0.08

# ── CORS & Client ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ── Cookie Domain (optional — needed for cross-subdomain cookies) ──────────────
# Leave blank for same-site deployments
# COOKIE_DOMAIN=.yourdomain.com

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_EMAIL=true
ENABLE_GOOGLE_OAUTH=false

# ── Email / SMTP (required when ENABLE_EMAIL=true) ────────────────────────────
# Use Gmail App Passwords: https://myaccount.google.com/apppasswords
EMAIL_USER=your-real-email@gmail.com
EMAIL_PASS=your-gmail-app-password-16-chars
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=noreply@yourdomain.com

# ── Google OAuth (required when ENABLE_GOOGLE_OAUTH=true) ────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=https://your-api.render.com/api/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Rotate any secret that was ever committed to version control.
# Use `openssl rand -hex 32` to generate secure random strings.
# ─────────────────────────────────────────────────────────────────────────────
